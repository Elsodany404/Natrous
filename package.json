{
  "name": "natrous",
  "version": "1.0.0",
  "description": "Natrous App",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "NODE_ENV=development nodemon dist/server.js",
    "compile:w": "tsc --watch",
    "compile": "tsc",
    "watch:client": "parcel watch client/ts/index.ts --dist-dir public --no-cache",
    "build:client": "parcel build client/ts/index.ts --dist-dir public --no-cache",
    "construct": "npm run build:client && npm run compile && npm run copy:assets",
    "copy:assets": "cp -r src/views dist/views",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clear": "rm -rf dist .parcel-cache"
  },
  "dependencies": {
    "@stripe/stripe-js": "^3.5.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "core-js": "^3.37.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "express-xss-sanitizer": "^1.2.0",
    "helmet": "^7.1.0",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pug": "^3.0.2",
    "sharp": "^0.33.4",
    "slugify": "^1.6.6",
    "stripe": "^15.8.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-xss-sanitizer": "^2.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/leaflet": "^1.9.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@types/pug": "^2.0.9",
    "@types/validator": "^13.11.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "buffer": "^6.0.3",
    "cpx": "^1.5.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.2",
    "nodemon": "^3.1.0",
    "parcel": "^2.12.0",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "last 2 versions",
      "Firefox ESR",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">= 18"
  }
}
